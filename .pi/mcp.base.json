{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "exposure": "deferred"
    },
    "context-mode": {
      "command": "context-mode",
      "lifecycle": "keep-alive",
      "exposure": "deferred"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "exposure": "deferred"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "exposure": "deferred"
    }
  }
}
