{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "exposure": "deferred"
    },
    "context-mode": {
      "command": "context-mode",
      "lifecycle": "keep-alive",
      "exposure": "deferred"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "exposure": "deferred"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "exposure": "deferred"
    },
    "rea": {
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@latest",
        "mcp"
      ],
      "exposure": "deferred"
    },
    "tcbs": {
      "url": "https://mcp.tcbs.com.vn/mcp/tcinvest/",
      "exposure": "codemode"
    }
  }
}
