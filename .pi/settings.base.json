{
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@xynogen/pix-footer",
    "npm:@spences10/pi-confirm-destructive",
    "npm:pi-context-view",
    "-npm:pi-observational-memory",
    "npm:@hiennguyen9874/pi-multi-edit",
    "git:github.com/hiennguyen9874/pi-grep-glob",
    "-git:github.com/hiennguyen9874/pi-ast-grep",
    "-npm:pi-context-prune",
    "-npm:context-mode",
    "-git:github.com/hiennguyen9874/pi-shake",
    "-git:github.com/MasuRii/pi-rtk-optimizer",
    "-git:github.com/hiennguyen9874/pi-goal",
    "-git:github.com/davebcn87/pi-autoresearch",
    "-npm:pi-btw",
    "-git:github.com/hiennguyen9874/pi-ask-user",
    "-npm:pi-prompt-template-model",
    "-npm:pi-subagents",
    "-npm:@gotgenes/pi-subagents",
    "-npm:pi-subagents-lite",
    "-npm:pi-intercom"
  ],
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp",
    "./extensions/command-history/index.ts",
    "./extensions/permission-gate.ts",
    "-./extensions/confirm-destructive.ts",
    "-./extensions/dirty-repo-guard.ts",
    "./extensions/inline-bash.ts",
    "./extensions/profile/index.ts",
    "./extensions/pi-documentation.ts",
    "-./extensions/disable-project-context.ts",
    "./extensions/skills-instructions-rewriter.ts",
    "./extensions/prompt-skills.ts",
    "./extensions/save-last-response.ts",
    "./extensions/dump-system-prompt.ts",
    "-./extensions/visual-explainer.ts",
    "-./extensions/disable-bash-tool.ts",
    "-./extensions/disable-edit-tools.ts",
    "-./extensions/disable-write-tool.ts",
    "-./extensions/enable-ls-tool.ts",
    "-./extensions/disable-read-tool.ts",
    "./extensions/system-prompt-appender.ts",
    "./extensions/remove-pi-env-guideline.ts",
    "./extensions/disable-om-recall-tool.ts"
  ],
  "extensionState": {
    "piDocumentationEnabled": false,
    "systemPromptAppenderEnabled": true,
    "systemPromptAppenderPromptPath": "system-prompt.md",
    "skillsInstructionsRewriterDisabledSkillFilters": [
      "context-mode",
      "ctx-doctor",
      "ctx-insight",
      "ctx-purge",
      "ctx-stats",
      "ctx-upgrade",
      "find-skills"
    ]
  },
  "enabledModels": [
    "openai-codex/*",
    "opencode-go/*",
    "opencode/*-free",
    "opencode/*-free*",
    "anthropic/*",
    "cliproxyapi/*",
    "openai/*"
  ],
  "showCacheMissNotices": true,
  "hideThinkingBlock": false,
  "piEdit": {
    "fuzzyMatch": true,
    "fuzzyThreshold": 0.95
  },
  "observational-memory": {
    "observeAfterTokens": 10000,
    "reflectAfterTokens": 20000,
    "compactAfterTokens": 120000,
    "compactAfterTokensMode": "calibrated",
    "compactAfterTokensRatio": 0.68,
    "observationsPoolMaxTokens": 20000,
    "observationsPoolTargetTokens": 10000,
    "agentMaxTurns": 16,
    "model": {
      "provider": "opencode-go",
      "id": "deepseek-v4.1-flash",
      "thinking": "high"
    },
    "showWorkerNotifications": true,
    "passive": false,
    "debugLog": false
  },
  "piCodexImageGen": {
    "mode": "minimal",
    "defaults": {
      "model": "gpt-image-2.5-flare",
      "quality": "auto",
      "size": "auto",
      "background": "auto"
    }
  },
  "warnings": {
    "anthropicExtraUsage": false
  }
}