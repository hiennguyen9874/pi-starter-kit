{
    "confirmEachCell": false,
    "backgroundNotices": true,
    "parallelWorkPrompt": true,
    "python": {
        "source": "uv",
        "version": "3.13",
        "defaultPackages": true,
        "packages": []
    },
    "output": {
        "maxBytes": 51200,
        "maxLines": 2000
    },
    "commandLog": {
        "maxBytes": 33554432
    },
    "piTools": {
        "list": true,
        "search": true
    },
    "prelude": {
        "defaults": true,
        "imports": [],
        "prompt": true
    },
    "systemPrompt": {
        "ipythonAfter": [
            "rules"
        ]
    },
    "modelCalls": {
        "enabled": true,
        "model": "openai/gpt-6-luna",
        "thinking": "high",
        "maxPerCell": 100,
        "maxOutputTokens": 8192,
        "classifier": "opencode/jev-1.13-free"
    }
}